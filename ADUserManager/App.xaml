<Application x:Class="ActiveManager.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    StartupUri="Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AppButtonHoverBackgroundBrush" Color="#E8F4FB" />
            <SolidColorBrush x:Key="AppButtonHoverBorderBrush" Color="#2B86A8" />
            <SolidColorBrush x:Key="AppButtonBorderBrush" Color="#D0D7DE" />
            <SolidColorBrush x:Key="AppButtonBlackTextBrush" Color="#111111" />
            <SolidColorBrush x:Key="AppButtonRedTextBrush" Color="#C62828" />
            <SolidColorBrush x:Key="AppButtonYellowTextBrush" Color="#C88400" />

            <Style x:Key="BaseAppButtonStyle" TargetType="ui:Button">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{StaticResource AppButtonBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="MouseOverBackground" Value="{StaticResource AppButtonHoverBackgroundBrush}" />
                <Setter Property="MouseOverBorderBrush" Value="{StaticResource AppButtonHoverBorderBrush}" />
                <Setter Property="PressedBackground" Value="{StaticResource AppButtonHoverBackgroundBrush}" />
                <Setter Property="PressedBorderBrush" Value="{StaticResource AppButtonHoverBorderBrush}" />
                <Setter Property="CornerRadius" Value="4" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ui:Button">
                            <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                                <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter x:Name="IconPresenter"
                                        Content="{TemplateBinding Icon}"
                                        Margin="0,0,8,0"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center" />
                                    <ContentPresenter x:Name="ContentPresenter"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                        RecognizesAccessKey="True" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="Icon" Value="{x:Null}">
                                    <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AppButtonHoverBackgroundBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AppButtonHoverBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource AppButtonHoverBackgroundBrush}" />
                                    <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource AppButtonHoverBorderBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.6" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BaseAppButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppButtonBlackTextBrush}" />
            </Style>

            <Style x:Key="SecondaryButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BaseAppButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppButtonBlackTextBrush}" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="ToolbarButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BaseAppButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppButtonBlackTextBrush}" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="DangerButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BaseAppButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppButtonRedTextBrush}" />
            </Style>

            <Style x:Key="GhostDangerButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BaseAppButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppButtonRedTextBrush}" />
                <Setter Property="Padding" Value="14,8" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>

            <Style x:Key="SuccessButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource BaseAppButtonStyle}">
                <Setter Property="Foreground" Value="{StaticResource AppButtonYellowTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
