<Page x:Class="ActiveManager.Views.Pages.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:ActiveManager.Localization">

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox Grid.Column="0"
                x:Name="HistorySearchBox"
                PlaceholderText="{Binding [Search_History_Placeholder], Source={x:Static loc:TranslationSource.Instance}}"
                Icon="{ui:SymbolIcon Search24}"
                KeyDown="SearchBox_KeyDown"
                TextChanged="SearchBox_TextChanged"
                Margin="0,0,8,0" />

            <ui:Button Grid.Column="1"
                Content="{Binding [Button_Refresh], Source={x:Static loc:TranslationSource.Instance}}"
                Style="{StaticResource ToolbarButtonStyle}"
                Icon="{ui:SymbolIcon ArrowSync24}"
                Click="OnRefresh" />
        </Grid>

        <DataGrid Grid.Row="1"
            x:Name="HistoryGrid"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            SelectionMode="Single"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            HeadersVisibility="Column"
            GridLinesVisibility="Horizontal"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            MouseDoubleClick="OnRowDoubleClick" SelectionChanged="HistoryGrid_SelectionChanged">

            <DataGrid.Columns>
                <DataGridTextColumn Header="{Binding [Column_ID], Source={x:Static loc:TranslationSource.Instance}}" Binding="{Binding Id}" Width="60" />
                <DataGridTextColumn Header="{Binding [Column_Name], Source={x:Static loc:TranslationSource.Instance}}" Binding="{Binding DisplayName}" Width="1.8*" />
                <DataGridTextColumn Header="{Binding [Column_Username], Source={x:Static loc:TranslationSource.Instance}}" Binding="{Binding SamAccountName}" Width="1.2*" />
                <DataGridTextColumn Header="{Binding [Column_TerminatedOn], Source={x:Static loc:TranslationSource.Instance}}" Binding="{Binding TerminatedAtText}" Width="1.3*" />
                <DataGridTextColumn Header="{Binding [Column_PerformedBy], Source={x:Static loc:TranslationSource.Instance}}" Binding="{Binding PerformedBy}" Width="1.2*" />
                <DataGridTextColumn Header="{Binding [Column_Actions], Source={x:Static loc:TranslationSource.Instance}}" Binding="{Binding StepsText}" Width="2.5*" />
                <DataGridTextColumn Header="{Binding [Column_Status], Source={x:Static loc:TranslationSource.Instance}}" Binding="{Binding StatusText}" Width="*" />
                <DataGridTemplateColumn Header="" Width="Auto">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <ui:Button Content="{Binding [Button_RestoreHistory], Source={x:Static loc:TranslationSource.Instance}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="8,4"
                                FontSize="12"
                                IsEnabled="{Binding CanRollback}"
                                Click="OnRollback" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</Page>
