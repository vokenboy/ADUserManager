<Page x:Class="ActiveManager.Views.Pages.ProfilePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:ActiveManager.Localization">

    <Page.Resources>
        <LinearGradientBrush x:Key="ProfileHeroBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#F7FBFF" Offset="0" />
            <GradientStop Color="#EDF5FB" Offset="0.58" />
            <GradientStop Color="#FAF8F4" Offset="1" />
        </LinearGradientBrush>

        <SolidColorBrush x:Key="ProfileHeroBorderBrush" Color="#D7E4EF" />
        <SolidColorBrush x:Key="ProfileMutedBrush" Color="#5F6B76" />
        <SolidColorBrush x:Key="ProfileAccentSoftBrush" Color="#E9F1F8" />

        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="ProfileHeaderStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="ProfileLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource ProfileMutedBrush}" />
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="ProfileValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Page.Resources>

    <Grid Margin="24,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <Grid>
                <StackPanel x:Name="ContentPanel" Visibility="Collapsed">
                    <Border Background="{StaticResource ProfileHeroBackgroundBrush}"
                    BorderBrush="{StaticResource ProfileHeroBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="20"
                    Margin="0,0,0,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="430" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock x:Name="HeroDisplayNameText"
                                FontSize="24"
                                FontWeight="SemiBold" />
                            <TextBlock x:Name="HeroIdentityText"
                                Margin="0,5,0,0"
                                Foreground="{StaticResource ProfileMutedBrush}"
                                TextWrapping="Wrap" />
                            <TextBlock x:Name="HeroNoteText"
                                Margin="0,10,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <Border x:Name="ProfileStatusBadgeBorder"
                                HorizontalAlignment="Left"
                                Padding="10,5"
                                CornerRadius="4"
                                BorderThickness="1">
                                <TextBlock x:Name="ProfileStatusBadgeText"
                                    FontWeight="SemiBold"
                                    FontSize="11" />
                            </Border>

                            <UniformGrid Columns="3" Margin="0,12,0,0">
                                <Border Style="{StaticResource ProfileCardStyle}" Margin="0,0,12,0" MinHeight="78">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_LastSignIn], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <TextBlock x:Name="SummaryLastLogonText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ProfileCardStyle}" Margin="0,0,12,0" MinHeight="78">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_PasswordUpdated], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <TextBlock x:Name="SummaryPasswordText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource ProfileCardStyle}" Margin="0" MinHeight="78">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_GroupMemberships], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <TextBlock x:Name="SummaryGroupCountText" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.2*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1.4*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource ProfileCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ProfileHeaderStyle}" Text="{Binding [Profile_ProtectedAccountDetails], Source={x:Static loc:TranslationSource.Instance}}" />

                                <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_Username], Source={x:Static loc:TranslationSource.Instance}}" />
                                <TextBlock x:Name="ReadOnlyUsernameText" Style="{StaticResource ProfileValueStyle}" />

                                <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_PrimaryEmail], Source={x:Static loc:TranslationSource.Instance}}" />
                                <TextBlock x:Name="ReadOnlyEmailText" Style="{StaticResource ProfileValueStyle}" />

                                <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_AccountStatus], Source={x:Static loc:TranslationSource.Instance}}" />
                                <TextBlock x:Name="ReadOnlyStatusText" Style="{StaticResource ProfileValueStyle}" />

                                <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_OrganizationalUnit], Source={x:Static loc:TranslationSource.Instance}}" />
                                <TextBlock x:Name="ReadOnlyOuText" Style="{StaticResource ProfileValueStyle}" />

                                <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_DistinguishedName], Source={x:Static loc:TranslationSource.Instance}}" />
                                <TextBlock x:Name="ReadOnlyDnText" Style="{StaticResource ProfileValueStyle}" Margin="0,0,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ProfileCardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ProfileHeaderStyle}" Text="{Binding [Profile_ProtectedMemberships], Source={x:Static loc:TranslationSource.Instance}}" />
                                <TextBlock Text="{Binding [Profile_ProtectedMembershipsHint], Source={x:Static loc:TranslationSource.Instance}}"
                                    Margin="0,0,0,14"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />
                                <Border Padding="12"
                                    CornerRadius="8"
                                    Background="{StaticResource ProfileAccentSoftBrush}"
                                    BorderBrush="{StaticResource ProfileHeroBorderBrush}"
                                    BorderThickness="1">
                                    <TextBlock x:Name="ReadOnlyGroupsText"
                                        TextWrapping="Wrap" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource ProfileCardStyle}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ProfileHeaderStyle}" Text="{Binding [Profile_EditableDetails], Source={x:Static loc:TranslationSource.Instance}}" />
                                <TextBlock Text="{Binding [Profile_EditableDetailsHint_Profile], Source={x:Static loc:TranslationSource.Instance}}"
                                    Margin="0,0,0,14"
                                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="12" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_FirstName], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <ui:TextBox x:Name="FirstNameBox" Margin="0,0,0,12" />

                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_Email], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <ui:TextBox x:Name="EditableEmailBox" Margin="0,0,0,12" />

                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_Department], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <ui:TextBox x:Name="DepartmentBox" Margin="0,0,0,0" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_LastName], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <ui:TextBox x:Name="LastNameBox" Margin="0,0,0,12" />

                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_JobTitle], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <ui:TextBox x:Name="TitleBox" Margin="0,0,0,12" />

                                        <TextBlock Style="{StaticResource ProfileLabelStyle}" Text="{Binding [Label_Description], Source={x:Static loc:TranslationSource.Instance}}" />
                                        <ui:TextBox x:Name="DescriptionBox" Margin="0,0,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ProfileCardStyle}" Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource ProfileHeaderStyle}" Text="{Binding [Profile_SaveChanges], Source={x:Static loc:TranslationSource.Instance}}" />
                                <TextBlock x:Name="StatusMessage"
                                    Margin="0,0,0,14"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <ui:Button x:Name="SaveButton"
                                        Content="{Binding [Button_Save], Source={x:Static loc:TranslationSource.Instance}}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="OnSave"
                                        Margin="0,0,8,0" />
                                    <ui:Button x:Name="CancelButton"
                                        Content="{Binding [Button_Reset], Source={x:Static loc:TranslationSource.Instance}}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Click="OnCancel" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </Grid>
                </StackPanel>

                <Border x:Name="EmptyStatePanel"
                    Visibility="Visible"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="34,32">
                    <StackPanel>
                        <TextBlock Text="{Binding [Profile_Unavailable_Title], Source={x:Static loc:TranslationSource.Instance}}"
                        FontSize="24"
                        FontWeight="SemiBold" />
                        <TextBlock x:Name="EmptyStateMessage"
                        Margin="0,10,0,0"
                        FontSize="14"
                        Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                        TextWrapping="Wrap"
                        Text="{Binding [Profile_Unavailable_Message], Source={x:Static loc:TranslationSource.Instance}}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
