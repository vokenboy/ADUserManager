<Window x:Class="ActiveManager.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:pages="clr-namespace:ActiveManager.Views.Pages"
    xmlns:loc="clr-namespace:ActiveManager.Localization"
    Title="ActiveManager"
    Width="1100" Height="700"
    MinWidth="1050" MinHeight="500"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource ApplicationBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:NavigationView Grid.Row="0"
            x:Name="RootNavigation"
            PaneDisplayMode="Left"
            OpenPaneLength="200"
            IsBackButtonVisible="Collapsed">

            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem x:Name="NavDashboard"
                    Content="{Binding [Nav_Dashboard], Source={x:Static loc:TranslationSource.Instance}}"
                    Icon="{ui:SymbolIcon Home24}"
                    TargetPageType="{x:Type pages:DashboardPage}" />
                <ui:NavigationViewItem x:Name="NavUsers"
                    Content="{Binding [Nav_Users], Source={x:Static loc:TranslationSource.Instance}}"
                    Icon="{ui:SymbolIcon People24}"
                    TargetPageType="{x:Type pages:UsersPage}" />
                <ui:NavigationViewItem x:Name="NavRestore"
                    Content="{Binding [Nav_Restore], Source={x:Static loc:TranslationSource.Instance}}"
                    Icon="{ui:SymbolIcon ClockToolbox24}"
                    TargetPageType="{x:Type pages:MementoPage}" />
                <ui:NavigationViewItem x:Name="NavErrorLog"
                    Content="{Binding [Nav_ErrorLog], Source={x:Static loc:TranslationSource.Instance}}"
                    Icon="{ui:SymbolIcon ErrorCircle24}"
                    TargetPageType="{x:Type pages:ErrorLogPage}" />
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem x:Name="NavSettings"
                    Content="{Binding [Nav_Settings], Source={x:Static loc:TranslationSource.Instance}}"
                    Icon="{ui:SymbolIcon Settings24}"
                    TargetPageType="{x:Type pages:SettingsPage}" />
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <Border Grid.Row="1" Padding="12,6" Background="{DynamicResource ControlFillColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" x:Name="StatusText"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <TextBlock Grid.Column="1" x:Name="UserCountText"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>
        </Border>
    </Grid>
</Window>
