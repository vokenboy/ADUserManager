<Window x:Class="ActiveManager.Views.Dialogs.ResetPasswordDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:ActiveManager.Localization"
    Title="Reset Password"
    Width="560" Height="320"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="SingleBorderWindow"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText"
                FontSize="18"
                FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Dialog_ResetPassword_Body], Source={x:Static loc:TranslationSource.Instance}}"
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            CornerRadius="8"
            Padding="16">
            <StackPanel>
                <TextBlock Text="{Binding [Dialog_ResetPassword_ActionTitle], Source={x:Static loc:TranslationSource.Instance}}"
                    FontWeight="SemiBold"
                    Margin="0,0,0,10" />
                <TextBlock Text="{Binding [Dialog_ResetPassword_Action1], Source={x:Static loc:TranslationSource.Instance}}"
                    Margin="0,0,0,6" />
                <TextBlock Text="{Binding [Dialog_ResetPassword_Action2], Source={x:Static loc:TranslationSource.Instance}}"
                    Margin="0,0,0,6" />
                <TextBlock Text="{Binding [Dialog_ResetPassword_Action3], Source={x:Static loc:TranslationSource.Instance}}"
                    Margin="0,0,0,6" />
                <TextBlock Text="{Binding [Dialog_ResetPassword_Action4], Source={x:Static loc:TranslationSource.Instance}}"
                    Margin="0,0,0,12" />

                <CheckBox x:Name="ForceChangeCheck"
                    IsChecked="True"
                    IsEnabled="False"
                    Content="{Binding [Dialog_ResetPassword_ForceChange], Source={x:Static loc:TranslationSource.Instance}}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            Margin="0,16,0,0">
            <ui:Button Content="{Binding [Button_ResetPassword], Source={x:Static loc:TranslationSource.Instance}}"
                Style="{StaticResource PrimaryButtonStyle}"
                Click="OnConfirm"
                Margin="0,0,8,0" />
            <ui:Button Content="{Binding [Button_Cancel], Source={x:Static loc:TranslationSource.Instance}}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
