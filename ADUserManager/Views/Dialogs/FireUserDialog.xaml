<Window x:Class="ActiveManager.Views.Dialogs.FireUserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:ActiveManager.Localization"
    Title="Terminate User"
    Width="560" Height="640"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="SingleBorderWindow"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HeaderText"
            FontSize="16" FontWeight="SemiBold"
            Margin="0,0,0,8" />

        <StackPanel Grid.Row="1" Margin="0,0,0,12">
            <TextBlock Text="{Binding [Terminate_ReasonLabel], Source={x:Static loc:TranslationSource.Instance}}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
            <ComboBox x:Name="ReasonCombo" HorizontalAlignment="Stretch" />
        </StackPanel>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12">
            <StackPanel>
                <CheckBox x:Name="DisableAccountCheck" IsChecked="True" Content="{Binding [Terminate_Step1], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,6" />
                <CheckBox x:Name="MoveToOUCheck" IsChecked="True" Content="{Binding [Terminate_Step2], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,6,0,4" Checked="OnMoveToOUChanged" Unchecked="OnMoveToOUChanged" />
                <ComboBox x:Name="OUCombo" Margin="24,0,0,6" HorizontalAlignment="Stretch" />
                <CheckBox x:Name="ChangePasswordCheck" IsChecked="True" Content="{Binding [Terminate_Step3], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,6" />
                <CheckBox x:Name="RemoveFromGroupsCheck" IsChecked="True" Content="{Binding [Terminate_Step4], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,6" />
                <CheckBox x:Name="SetExpirationCheck" IsChecked="True" Content="{Binding [Terminate_Step5], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,6,0,4" Checked="OnExpirationChanged" Unchecked="OnExpirationChanged" />
                <DatePicker x:Name="ExpirationDatePicker" Margin="24,0,0,6" SelectedDate="{x:Static System:DateTime.Today}" HorizontalAlignment="Stretch" xmlns:System="clr-namespace:System;assembly=mscorlib" />
                <CheckBox x:Name="ExportDataCheck" IsChecked="True" Content="{Binding [Terminate_Step6], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,6,0,4" Checked="OnExportChanged" Unchecked="OnExportChanged" />

                <Grid x:Name="ExportOptionsPanel" Margin="24,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="70" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding [Label_Format], Source={x:Static loc:TranslationSource.Instance}}" VerticalAlignment="Center" />
                    <ComboBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" x:Name="ExportFormatCombo" Margin="0,0,0,6" SelectionChanged="OnExportFormatChanged">
                        <ComboBoxItem Content="CSV" IsSelected="True" />
                        <ComboBoxItem Content="JSON" />
                        <ComboBoxItem Content="XML" />
                    </ComboBox>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding [Label_Path], Source={x:Static loc:TranslationSource.Instance}}" VerticalAlignment="Center" />
                    <TextBox Grid.Row="1" Grid.Column="1" x:Name="ExportPathText" IsReadOnly="True" Margin="0,0,4,6" />
                    <ui:Button Grid.Row="1" Grid.Column="2" Style="{StaticResource SecondaryButtonStyle}" Content="..." Click="OnBrowseExportPath" Padding="8,4" Margin="0,0,0,6" />

                    <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,0,0,6">
                        <CheckBox x:Name="ExportGroupsCheck" Content="{Binding [Label_GroupMemberships], Source={x:Static loc:TranslationSource.Instance}}" IsChecked="True" Margin="0,0,16,0" />
                        <CheckBox x:Name="ExportPermissionsCheck" Content="{Binding [Label_Permissions], Source={x:Static loc:TranslationSource.Instance}}" IsChecked="True" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{Binding [Button_Confirm], Source={x:Static loc:TranslationSource.Instance}}" Style="{StaticResource PrimaryButtonStyle}" Click="OnConfirm" Margin="0,0,8,0" />
            <ui:Button Content="{Binding [Button_Cancel], Source={x:Static loc:TranslationSource.Instance}}" Style="{StaticResource SecondaryButtonStyle}" Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
