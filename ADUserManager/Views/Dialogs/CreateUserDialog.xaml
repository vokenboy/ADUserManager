<Window x:Class="ActiveManager.Views.Dialogs.CreateUserDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:ActiveManager.Localization"
    Title="Add User"
    Width="760" Height="760"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="SingleBorderWindow"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding [Dialog_CreateUser_Title], Source={x:Static loc:TranslationSource.Instance}}"
                FontSize="18"
                FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Dialog_CreateUser_Body], Source={x:Static loc:TranslationSource.Instance}}"
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="{Binding [Label_FirstName], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="FirstNameBox" />
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="12,0,0,12">
                            <TextBlock Text="{Binding [Label_LastName], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="LastNameBox" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,12,12">
                            <TextBlock Text="{Binding [Label_Username], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="SamAccountNameBox" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,0,0,12">
                            <TextBlock Text="{Binding [Label_Email], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="EmailBox" />
                        </StackPanel>

                        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
                            <TextBlock Text="{Binding [Label_Location], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,4" />
                            <ComboBox x:Name="OUCombo" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16"
                    Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="{Binding [Label_Department], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="DepartmentBox" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="12,0,12,0">
                            <TextBlock Text="{Binding [Label_JobTitle], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="TitleBox" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Margin="12,0,0,0">
                            <TextBlock Text="{Binding [Label_Description], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,4" />
                            <ui:TextBox x:Name="DescriptionBox" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border BorderThickness="1"
                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0"
                            Text="{Binding [Label_GroupSearch], Source={x:Static loc:TranslationSource.Instance}}"
                            FontWeight="SemiBold" />
                        <TextBlock Grid.Row="0" Grid.Column="1"
                            Text="{Binding [Label_SelectedGroups], Source={x:Static loc:TranslationSource.Instance}}"
                            FontWeight="SemiBold"
                            Margin="12,0,0,0" />

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,8,12,8">
                            <ui:TextBox x:Name="GroupSearchBox"
                                PlaceholderText="{Binding [Placeholder_GroupSearch], Source={x:Static loc:TranslationSource.Instance}}"
                                TextChanged="OnGroupSearchChanged" />
                            <TextBlock x:Name="GroupSearchStatusText"
                                Margin="0,6,0,0"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap"
                                Text="{Binding [Hint_GroupSearch], Source={x:Static loc:TranslationSource.Instance}}" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="12,8,0,8">
                            <TextBlock x:Name="DisplayNamePreview"
                                Text="Display Name: -"
                                Margin="0,0,0,4" />
                            <TextBlock Text="{Binding [Hint_DisplayName], Source={x:Static loc:TranslationSource.Instance}}"
                                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="2" Grid.Column="0" Margin="0,0,12,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ui:Button x:Name="AddGroupButton"
                                Grid.Row="0"
                                Content="{Binding [Button_AddGroup], Source={x:Static loc:TranslationSource.Instance}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnAddGroup"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                IsEnabled="False" />

                            <ListBox x:Name="AvailableGroupsList"
                                Grid.Row="1"
                                DisplayMemberPath="Name"
                                MinHeight="220"
                                MaxHeight="260"
                                SelectionChanged="OnAvailableGroupSelectionChanged"
                                MouseDoubleClick="OnAvailableGroupDoubleClick" />
                        </Grid>

                        <Grid Grid.Row="2" Grid.Column="1" Margin="12,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <ui:Button x:Name="RemoveGroupButton"
                                Grid.Row="0"
                                Content="{Binding [Button_RemoveGroup], Source={x:Static loc:TranslationSource.Instance}}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Click="OnRemoveGroup"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,8"
                                IsEnabled="False" />

                            <ListBox x:Name="SelectedGroupsList"
                                Grid.Row="1"
                                DisplayMemberPath="Name"
                                MinHeight="220"
                                MaxHeight="260"
                                SelectionChanged="OnSelectedGroupSelectionChanged" />
                        </Grid>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2">
            <TextBlock x:Name="ValidationMessageText"
                Foreground="IndianRed"
                TextWrapping="Wrap"
                Margin="0,12,0,12"
                Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="CreateButton"
                    Content="{Binding [Button_Create], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnCreate"
                    Margin="0,0,8,0" />
                <ui:Button Content="{Binding [Button_Cancel], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnCancel" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
