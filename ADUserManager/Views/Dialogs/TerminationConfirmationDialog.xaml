<Window x:Class="ActiveManager.Views.Dialogs.TerminationConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:ActiveManager.Localization"
    Title="Confirm Termination"
    Width="530" Height="500"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="SingleBorderWindow"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="{Binding [Dialog_ConfirmTermination_Question], Source={x:Static loc:TranslationSource.Instance}}"
                FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock x:Name="UserNameText"
                FontSize="20" FontWeight="Bold"
                Foreground="#C62828"
                Margin="0,0,0,8" />
            <TextBlock x:Name="UserDetailsText"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                LineHeight="22" />
        </StackPanel>

        <GroupBox Grid.Row="1" Header="{Binding [Dialog_ActionsToPerform], Source={x:Static loc:TranslationSource.Instance}}" Margin="0,0,0,12">
            <TextBox x:Name="StepsSummaryText"
                IsReadOnly="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                BorderThickness="0"
                Background="Transparent"
                FontFamily="Segoe UI"
                FontSize="13" />
        </GroupBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{Binding [Button_YesTerminate], Source={x:Static loc:TranslationSource.Instance}}"
                Style="{StaticResource DangerButtonStyle}"
                Click="OnConfirm"
                Margin="0,0,8,0" />
            <ui:Button Content="{Binding [Button_Cancel], Source={x:Static loc:TranslationSource.Instance}}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
