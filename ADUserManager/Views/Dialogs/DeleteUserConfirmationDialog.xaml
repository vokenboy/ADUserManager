<Window x:Class="ActiveManager.Views.Dialogs.DeleteUserConfirmationDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:ActiveManager.Localization"
    Title="Confirm Deletion"
    Width="520"
    Height="340"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="SingleBorderWindow"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="{Binding [Dialog_DeleteUser_Title], Source={x:Static loc:TranslationSource.Instance}}"
                FontSize="18"
                FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Dialog_DeleteUser_Body], Source={x:Static loc:TranslationSource.Instance}}"
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{Binding [Label_Name], Source={x:Static loc:TranslationSource.Instance}}" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="DisplayNameText" Margin="0,0,0,10" FontWeight="SemiBold" TextWrapping="Wrap" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,10" VerticalAlignment="Center" Text="{Binding [Label_Username], Source={x:Static loc:TranslationSource.Instance}}" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="SamAccountNameText" Margin="0,0,0,10" TextWrapping="Wrap" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding [Label_Email], Source={x:Static loc:TranslationSource.Instance}}" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="EmailText" TextWrapping="Wrap" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <ui:Button Content="{Binding [Button_Delete], Source={x:Static loc:TranslationSource.Instance}}"
                Style="{StaticResource DangerButtonStyle}"
                Click="OnConfirm"
                Margin="0,0,8,0" />
            <ui:Button Content="{Binding [Button_Cancel], Source={x:Static loc:TranslationSource.Instance}}"
                Style="{StaticResource SecondaryButtonStyle}"
                Click="OnCancel" />
        </StackPanel>
    </Grid>
</Window>
