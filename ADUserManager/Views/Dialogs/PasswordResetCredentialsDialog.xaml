<Window x:Class="ActiveManager.Views.Dialogs.PasswordResetCredentialsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:loc="clr-namespace:ActiveManager.Localization"
    Title="Password Reset Complete"
    Width="560" Height="360"
    WindowStartupLocation="CenterOwner"
    ResizeMode="NoResize"
    WindowStyle="SingleBorderWindow"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText"
                FontSize="18"
                FontWeight="SemiBold" />
            <TextBlock Text="{Binding [Dialog_Credentials_CopyHint], Source={x:Static loc:TranslationSource.Instance}}"
                Margin="0,4,0,0"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <Border Grid.Row="1"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            CornerRadius="8"
            Padding="16"
            Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,12,12" VerticalAlignment="Center" Text="{Binding [Label_Username], Source={x:Static loc:TranslationSource.Instance}}" />
                <TextBox Grid.Row="0" Grid.Column="1"
                    x:Name="UsernameBox"
                    Margin="0,0,0,12"
                    IsReadOnly="True" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center" Text="{Binding [Label_Password], Source={x:Static loc:TranslationSource.Instance}}" />
                <TextBox Grid.Row="1" Grid.Column="1"
                    x:Name="PasswordBox"
                    IsReadOnly="True" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
            BorderThickness="1"
            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
            CornerRadius="8"
            Padding="16">
            <TextBlock x:Name="DetailsText"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock x:Name="CopyStatusText"
                Margin="0,0,0,12"
                Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="{Binding [Button_CopyCredentials], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Click="OnCopy"
                    Margin="0,0,8,0" />
                <ui:Button Content="{Binding [Button_Close], Source={x:Static loc:TranslationSource.Instance}}"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Click="OnClose" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
